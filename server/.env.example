PORT=4000
MONGO_URI=mongodb://localhost:27017/nexusflow

# REQUIRED. The server refuses to start unless JWT_SECRET is >= 32 bytes of
# random data and not a placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Tokens are signed/verified with HS256 only and expire after 7 days.
JWT_SECRET=

# Tests NEVER use MONGO_URI. The isolated suites (npm test / npm run test:phase1)
# start their own in-memory MongoDB. Legacy DB scripts (npm run test:legacy)
# require a LOCAL disposable database whose name contains "test":
#   MONGO_URI_TEST=mongodb://127.0.0.1:27017/nexusflow_test
MONGO_URI_TEST=

# NEXUSFLOW HARD $0 LLM COST POLICY — FREE TIER ONLY
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# NEXUSFLOW 3.0 — Phase 11: GitHub Integration (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://nexusflow-nxeg.onrender.com/api/github/auth/callback

# NEXUSFLOW 3.0 — Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nexusflow-nxeg.onrender.com/api/auth/google/callback

# GitHub token encryption key — REQUIRED in production, >= 32 random characters.
# Generate like JWT_SECRET; never reuse the JWT secret.
ENCRYPTION_KEY=

# ── Password recovery e-mail (Phase 2) ─────────────────────────────────────
# Any free SMTP service works (e.g. Gmail SMTP with an app password, Brevo free
# tier). If unset, reset requests still answer generically but NO e-mail is
# sent (logged as mailer:not_configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexusFlow <no-reply@example.com>"
# Base URL of the web app that serves /reset-password (defaults to FRONTEND_URL).
PASSWORD_RESET_BASE_URL=
# Reset link lifetime in minutes (5–60, default 20).
PASSWORD_RESET_TTL_MINUTES=20

# ── Rate limiting (Phase 2; instance-local, optional overrides) ────────────
# Number of trusted reverse-proxy hops for client IPs (Render: 1; local: 0).
TRUST_PROXY=
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_FAILURES_MAX=5
RATE_LIMIT_SIGNUP_IP_MAX=5
RATE_LIMIT_FORGOT_IP_MAX=10
RATE_LIMIT_FORGOT_ACCOUNT_MAX=3
RATE_LIMIT_RESET_IP_MAX=10
RATE_LIMIT_OAUTH_IP_MAX=20

# Frontend URL (for OAuth redirects and CORS)
FRONTEND_URL=https://nexusflow-eta.vercel.app
