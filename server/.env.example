PORT=4000
MONGO_URI=mongodb://localhost:27017/nexusflow

# REQUIRED. The server refuses to start unless JWT_SECRET is >= 32 bytes of
# random data and not a placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Tokens are signed/verified with HS256 only and expire after 7 days.
JWT_SECRET=

# Tests NEVER use MONGO_URI. The isolated suites (npm test / npm run test:phase1)
# start their own in-memory MongoDB. Legacy DB scripts (npm run test:legacy)
# require a LOCAL disposable database whose name contains "test":
#   MONGO_URI_TEST=mongodb://127.0.0.1:27017/nexusflow_test
MONGO_URI_TEST=

# NEXUSFLOW HARD $0 LLM COST POLICY — FREE TIER ONLY
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# NEXUSFLOW 3.0 — Phase 11: GitHub Integration (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://nexusflow-nxeg.onrender.com/api/github/auth/callback

# NEXUSFLOW 3.0 — Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nexusflow-nxeg.onrender.com/api/auth/google/callback

# ── GitHub token encryption (Phase 4: AES-256-GCM) ─────────────────────────
# REQUIRED to store GitHub credentials (no development fallback). Exactly 32
# bytes, base64 / base64url / 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never derive from or reuse JWT_SECRET.
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
# Short id written into each envelope (rotate by changing key + id).
GITHUB_TOKEN_ENCRYPTION_KEY_ID=k1
# Optional, decrypt-only previous keys during rotation: "k1:<base64>,k0:<base64>"
GITHUB_TOKEN_PREVIOUS_KEYS=
# Migration only: the OLD ENCRYPTION_KEY value used for legacy AES-256-CBC
# tokens. Remove after scripts/migrations/phase4GitHubTokenMigration.js --apply.
GITHUB_TOKEN_LEGACY_KEY=

# ── Password recovery e-mail (Phase 2) ─────────────────────────────────────
# Any free SMTP service works (e.g. Gmail SMTP with an app password, Brevo free
# tier). If unset, reset requests still answer generically but NO e-mail is
# sent (logged as mailer:not_configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexusFlow <no-reply@example.com>"
# Base URL of the web app that serves /reset-password (defaults to FRONTEND_URL).
PASSWORD_RESET_BASE_URL=
# Reset link lifetime in minutes (5–60, default 20).
PASSWORD_RESET_TTL_MINUTES=20

# ── Rate limiting (Phase 2; instance-local, optional overrides) ────────────
# Number of trusted reverse-proxy hops for client IPs (Render: 1; local: 0).
TRUST_PROXY=
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_FAILURES_MAX=5
RATE_LIMIT_SIGNUP_IP_MAX=5
RATE_LIMIT_FORGOT_IP_MAX=10
RATE_LIMIT_FORGOT_ACCOUNT_MAX=3
RATE_LIMIT_RESET_IP_MAX=10
RATE_LIMIT_OAUTH_IP_MAX=20

# Frontend URL (for OAuth redirects and CORS)
FRONTEND_URL=https://nexusflow-eta.vercel.app

# ── AI routing (Phase 4) — zero-cost, bounded; all optional ────────────────
# Without any AI key the app runs normally with deterministic features only.
# Disable specific registry models (comma list, e.g. gemini-2.5-flash):
AI_DISABLED_MODELS=
# Operator-approved OpenRouter ":free" variants (comma list). Empty = none.
OPENROUTER_FREE_MODELS=
# Global per-request AI deadline in ms (5000–120000, default 25000).
AI_REQUEST_DEADLINE_MS=25000
# Max provider attempts per request (1–8, default 4).
AI_MAX_PROVIDER_ATTEMPTS=4
# Circuit breaker: failures before opening (default 3) and cooldown ms (default 60000).
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=60000
# Usage limits (instance-local).
AI_USER_REQUESTS_PER_MINUTE=10
AI_EXPENSIVE_REQUESTS_PER_MINUTE=3
AI_USER_CONCURRENT_REQUESTS=2
AI_WORKSPACE_CONCURRENT_REQUESTS=3
AI_WORKSPACE_REQUESTS_PER_MINUTE=30
# Scoped AI cache (0 disables) and max outbound context characters.
AI_CACHE_TTL_MS=600000
AI_CACHE_MAX_ENTRIES=500
AI_MAX_INPUT_CHARS=60000

# ── Backend lifecycle (Phase 4) ─────────────────────────────────────────────
# Startup MongoDB connection attempts (1–20, default 5) and per-attempt timeout.
MONGO_CONNECT_ATTEMPTS=5
MONGO_CONNECT_TIMEOUT_MS=10000
# Graceful shutdown deadline in ms (default 10000). Health: /health/live, /health/ready, /health
SHUTDOWN_TIMEOUT_MS=10000

# ── Native Google sign-in (Phase 4) ─────────────────────────────────────────
# App deep-link scheme (must match client app.json "scheme"); default nexusflow.
GOOGLE_NATIVE_REDIRECT_SCHEME=nexusflow

# ── Task assignment policy (Phase 4) ────────────────────────────────────────
# Disclosed effort assumed for tasks without an estimate (hours, default 4).
ASSIGNMENT_UNKNOWN_EFFORT_HOURS=4
# Optional per-member task cap (fairness). Empty = hour capacity only.
ASSIGNMENT_MAX_TASKS_PER_MEMBER=
